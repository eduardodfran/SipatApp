{
  "expo": {
    "name": "SipatApp",
    "slug": "SipatApp",
    "scheme": "sipat",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/sipat-app.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "icon": "./assets/sipat-app.png",
      "package": "com.eduardofran.SipatApp",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "sipat"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to access your camera",
          "microphonePermission": "Allow $(PRODUCT_NAME) to access your microphone",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow $(PRODUCT_NAME) to access your location while you use the app."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-web-browser",
      "expo-font",
      "expo-audio",
      [
        "expo-splash-screen",
        {
          "image": "./assets/sipat-logo-splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#0c0c14"
        }
      ],
      "expo-status-bar",
      "expo-asset"
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "789b21e9-5033-40c1-9d9d-7f99483c9f3e"
      }
    }
  }
}
